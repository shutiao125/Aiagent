# ===== 数据库（MySQL 8.4）=====
# 本地直接 python run.py 时 DB_HOST 填 127.0.0.1；Docker Compose 内部固定为 mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=aiapp
DB_PASSWORD=aiapp_pass_2026
DB_NAME=ai_assistant
# 应用启动时连接 MySQL 的重试次数（容器首次启动等待数据库就绪）
DB_CONNECT_RETRIES=30

# ===== Docker Compose 专用（仅容器部署时使用）=====
MYSQL_ROOT_PASSWORD=root_pass_2026
# MySQL 映射到宿主机的端口（默认 3307，避免与本机 3306 冲突）
MYSQL_PORT=3307
# Web 服务映射到宿主机的端口
WEB_PORT=8000

# ===== 火山方舟 Doubao =====
# 真实调用时填写；留空且 MOCK_LLM=0 时接口将返回明确的配置错误
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID（需与账号已开通版本一致）或方舟在线推理接入点 ID（ep-xxxx）
# 可用 GET https://ark.cn-beijing.volces.com/api/v3/models（带 Authorization: Bearer key）查询
ARK_MODEL=doubao-seed-2-1-pro-260915

# ===== 对话参数 =====
# 携带给模型的最近历史消息条数上限
CONTEXT_LIMIT=20
SYSTEM_PROMPT=你是一个乐于助人、回答严谨的中文 AI 助手。
# 1=使用本地模拟流式回复（无需 API Key，供离线演示/联调）；0=真实调用 Doubao
MOCK_LLM=1

# ===== 服务 =====
PORT=8000
